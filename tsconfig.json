{
  "compilerOptions": {
    "lib": [
      "ES2021.String"
    ],
    "rootDir": "./src",
    "outDir": "./dist",
    "downlevelIteration": true,
    "declaration": true,
    "incremental": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
  },
  "exclude": [
    "test/",
    "node_modules/",
    "*/*.d.ts",
    "**/*.spec.ts",
  ]
}